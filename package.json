{
  "name": "conjureos-app-recipes",
  "version": "0.1.0",
  "description": "Recipe-from-fridge — an app for ConjureOS. Point your camera at the fridge, get recipes you can make tonight.",
  "type": "module",
  "license": "MIT",
  "author": "Jonny-B",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jonny-B/conjureos-app-recipes.git"
  },
  "conjureos": {
    "displayName": "Recipes",
    "icon": "fa:utensils",
    "permissions": ["ai.complete", "vfs.read", "vfs.write"],
    "promptSuggestions": [
      "Show me recipes I can make with what's in my fridge",
      "What's quick to cook with chicken and rice?"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
