{
  "name": "conjureos-app-recipes",
  "version": "0.52.0",
  "description": "Recipes for ConjureOS: a library you add to, browse and cook from. Write a recipe, photograph one, or describe a dish and have one written; then cook it step by step.",
  "type": "module",
  "license": "MIT",
  "author": "Jonny-B",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jonny-B/conjureos-app-recipes.git"
  },
  "conjureos": {
    "displayName": "Recipes",
    "icon": "fa:utensils",
    "permissions": [
      "ai.complete",
      "vfs.read",
      "vfs.write"
    ],
    "actions": {
      "listRecipes": {
        "permission": "actions.read",
        "description": "List the user's saved recipes, optionally filtered by title or ingredient substring. Returns title, slug, difficulty, cookTime, servings, ingredients, savedAt, madeCount, lastMadeAt, and per-serving nutrition when available.",
        "params": {
          "type": "object",
          "properties": {
            "filter": {
              "type": "string",
              "maxLength": 100,
              "description": "Case-insensitive substring matched against title, summary, and ingredients."
            },
            "limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500,
              "description": "Max recipes to return (default 50)."
            }
          }
        },
        "returns": {
          "type": "object",
          "properties": {
            "recipes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slug": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "difficulty": {
                    "type": "string",
                    "enum": [
                      "easy",
                      "medium",
                      "hard"
                    ]
                  },
                  "cookTime": {
                    "type": "integer",
                    "description": "Minutes."
                  },
                  "servings": {
                    "type": "integer"
                  },
                  "ingredients": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "savedAt": {
                    "type": "string",
                    "description": "ISO timestamp."
                  },
                  "madeCount": {
                    "type": "integer"
                  },
                  "lastMadeAt": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "ISO timestamp of the last cook, or null."
                  },
                  "nutrition": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "Per-serving estimate, or null when the lookup hasn't run or failed.",
                    "properties": {
                      "calories": {
                        "type": "integer"
                      },
                      "protein": {
                        "type": "integer",
                        "description": "Grams."
                      },
                      "fat": {
                        "type": "integer",
                        "description": "Grams."
                      },
                      "carbs": {
                        "type": "integer",
                        "description": "Grams."
                      },
                      "matched": {
                        "type": "integer",
                        "description": "Ingredients matched to USDA entries."
                      },
                      "total": {
                        "type": "integer",
                        "description": "Total ingredient count."
                      },
                      "est": {
                        "type": "boolean",
                        "description": "Always true: estimated, not measured."
                      }
                    },
                    "required": [
                      "calories",
                      "protein",
                      "fat",
                      "carbs",
                      "matched",
                      "total",
                      "est"
                    ]
                  }
                },
                "required": [
                  "slug",
                  "title",
                  "difficulty",
                  "cookTime",
                  "servings",
                  "ingredients",
                  "savedAt",
                  "madeCount",
                  "lastMadeAt",
                  "nutrition"
                ]
              }
            }
          },
          "required": [
            "recipes"
          ]
        }
      },
      "getRecipe": {
        "permission": "actions.read",
        "description": "Fetch one saved recipe by slug. Returns the full recipe including ingredients, instructions, summary, servings, and nutrition. Useful when a calorie tracker wants to log every ingredient of a meal the user cooked.",
        "params": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "maxLength": 80,
              "description": "URL-safe recipe id (lowercase letters, digits, hyphens)."
            }
          },
          "required": [
            "slug"
          ]
        },
        "returns": {
          "type": "object",
          "properties": {
            "recipe": {
              "type": [
                "object",
                "null"
              ],
              "description": "Full saved recipe (title, ingredients, instructions, summary, servings, nutrition), or null if no match."
            }
          },
          "required": [
            "recipe"
          ]
        }
      },
      "addRecipe": {
        "permission": "actions.write",
        "description": "Save a recipe to the user's Recipes folder. Takes title, difficulty, cookTime, servings, ingredients, instructions, and optional summary + nutrition. Useful for meal planners pushing recipes into the user's library.",
        "params": {
          "type": "object",
          "properties": {
            "recipe": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 80
                },
                "difficulty": {
                  "type": "string",
                  "enum": [
                    "easy",
                    "medium",
                    "hard"
                  ]
                },
                "cookTime": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 720,
                  "description": "Minutes."
                },
                "servings": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 24,
                  "description": "Defaults to 2 when omitted."
                },
                "ingredients": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "maxItems": 30
                },
                "instructions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "maxItems": 30
                },
                "summary": {
                  "type": "string",
                  "maxLength": 400
                },
                "nutrition": {
                  "type": "object",
                  "description": "Per-serving estimate (optional).",
                  "properties": {
                    "calories": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10000
                    },
                    "protein": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "fat": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "carbs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  }
                }
              },
              "required": [
                "title",
                "difficulty",
                "cookTime",
                "ingredients",
                "instructions"
              ]
            }
          },
          "required": [
            "recipe"
          ]
        },
        "returns": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "path": {
              "type": "string",
              "description": "VFS path the recipe was saved to."
            }
          },
          "required": [
            "slug",
            "path"
          ]
        }
      },
      "importRecipeFromImage": {
        "permission": "actions.write",
        "description": "Transcribe a recipe from one or more attached photos (a recipe card, cookbook or magazine page, handwritten note, or screenshot) and save it to the user's recipe library. Takes images: an array of { mediaType, data } photos. THIS is the action to use when the user attaches a photo of a recipe and asks to add, save, or import it into their recipes.",
        "params": {
          "type": "object",
          "properties": {
            "images": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "description": "Photos of the recipe, in reading order. Extra images beyond 6 are ignored.",
              "items": {
                "type": "object",
                "properties": {
                  "mediaType": {
                    "type": "string",
                    "enum": [
                      "image/jpeg",
                      "image/png",
                      "image/webp",
                      "image/gif"
                    ]
                  },
                  "data": {
                    "type": "string",
                    "description": "Base64-encoded image bytes, no data: prefix."
                  }
                },
                "required": [
                  "mediaType",
                  "data"
                ]
              }
            }
          },
          "required": [
            "images"
          ]
        },
        "returns": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        }
      },
      "markCooked": {
        "permission": "actions.write",
        "description": "Mark a saved recipe as cooked (increment madeCount, update lastMadeAt). Takes slug. Useful for calorie/health apps confirming that a meal was eaten.",
        "params": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "maxLength": 80,
              "description": "URL-safe recipe id."
            }
          },
          "required": [
            "slug"
          ]
        },
        "returns": {
          "type": "object",
          "properties": {
            "madeCount": {
              "type": "integer"
            },
            "lastMadeAt": {
              "type": "string",
              "description": "ISO timestamp of this cook."
            }
          },
          "required": [
            "madeCount",
            "lastMadeAt"
          ]
        }
      },
      "searchRecipes": {
        "permission": "actions.read",
        "description": "Search the built-in recipe catalog (~1,200 recipes) by free text and/or category. Use this to FIND a recipe the user does not already have; listRecipes only sees their own saved library.",
        "params": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "maxLength": 100,
              "description": "Free text matched against title, ingredients and tags."
            },
            "category": {
              "type": "string",
              "maxLength": 40,
              "description": "One of the categories from listCategories."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        },
        "returns": {
          "type": "object",
          "properties": {
            "recipes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "difficulty": {
                    "type": "string"
                  },
                  "cookTime": {
                    "type": "integer"
                  },
                  "servings": {
                    "type": "integer"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "listCategories": {
        "permission": "actions.read",
        "description": "The catalog's category taxonomy with a count per category, so a caller can offer sensible filters.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "returns": {
          "type": "object",
          "properties": {
            "categories": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "count": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "setFavorite": {
        "permission": "actions.write",
        "description": "Mark or unmark one of the user's saved recipes as a favourite. Reversible.",
        "params": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "favorite": {
              "type": "boolean"
            }
          },
          "required": [
            "slug",
            "favorite"
          ]
        },
        "returns": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "favorite": {
              "type": "boolean"
            }
          }
        }
      },
      "setBlocked": {
        "permission": "actions.write",
        "description": "Stop (or resume) the week planner suggesting a catalog recipe. Affects RECOMMENDATIONS only \u2014 the recipe stays searchable, openable and cookable. Reversible.",
        "params": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "blocked": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "blocked"
          ]
        },
        "returns": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "blocked": {
              "type": "boolean"
            },
            "count": {
              "type": "integer"
            }
          }
        }
      },
      "getBlocked": {
        "permission": "actions.read",
        "description": "Catalog ids the user has thumbs-downed, so a caller can avoid re-suggesting them.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "returns": {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "scaleSavedRecipe": {
        "permission": "actions.read",
        "description": "Rescale one of the user's saved recipes to a different serving count and return the result. Does not modify the stored copy.",
        "params": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "servings": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "required": [
            "slug",
            "servings"
          ]
        },
        "returns": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "servings": {
              "type": "integer"
            },
            "ingredients": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "saved": {
              "type": "boolean",
              "description": "Always false \u2014 this action never persists."
            }
          }
        }
      }
    },
    "remoteActions": {
      "recipesDb": {
        "url": "https://ntgelbtepecqsqloxmct.supabase.co/functions/v1/recipes-db",
        "method": "POST"
      }
    },
    "promptSuggestions": [
      "What can I cook with chicken and rice?",
      "Save this recipe to my library",
      "What did I cook this week?"
    ]
  },
  "//": "No Vite. `npm run dev` is the esbuild dev server from @conjureos/pack; the published build goes through ConjureOS @bundle in CI (same as a user-published app). Bump `version` here AND in src/version.ts together.",
  "scripts": {
    "dev": "conj-pack dev",
    "build": "npx -y tsx scripts/build-bundle.mjs",
    "typecheck": "tsc -b --noEmit",
    "test": "npx -y tsx scripts/theme.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@conjureos/pack": "^0.1.1",
    "@conjureos/ui": "^1.0.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
